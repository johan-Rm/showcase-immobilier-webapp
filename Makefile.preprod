# ============================
# Docker Compose PREPROD
# ============================

PREPROD_ENV_FILE ?= .env.preprod
# ENV_FILE est exporté pour que `env_file:` dans le compose pointe le même
# fichier que `--env-file` (source unique de vérité, surcharge cohérente).
COMPOSE_PREPROD = ENV_FILE=$(PREPROD_ENV_FILE) docker compose --env-file $(PREPROD_ENV_FILE) -f docker-compose.preprod.yml

PREPROD_CORE_SERVICES = webapp-ssr
PREPROD_BUILD_SERVICES = webapp-ssr

.PHONY: preprod-check preprod-up preprod-up-build preprod-up-wait preprod-down preprod-clean preprod-stop preprod-status
.PHONY: preprod-build preprod-build-no-cache preprod-pull preprod-deploy preprod-deploy-no-cache
.PHONY: preprod-content-sync preprod-content-sync-dry
.PHONY: preprod-logs preprod-logs-service preprod-logs-webapp

# Préflight : valide la configuration avant tout build/up (bloquant)

preprod-check:
	@scripts/ci/deploy-check.sh $(PREPROD_ENV_FILE) docker-compose.preprod.yml preprod

# Content Sync

preprod-content-sync:
	$(COMPOSE_PREPROD) run --rm content-sync

preprod-content-sync-dry:
	$(COMPOSE_PREPROD) run --rm content-sync bun scripts/content-sync.ts --dry-run

# Up / Build / Deploy

preprod-up:
	$(COMPOSE_PREPROD) up -d $(PREPROD_CORE_SERVICES)

preprod-up-wait:
	$(COMPOSE_PREPROD) up -d --wait $(PREPROD_CORE_SERVICES)

preprod-up-build:
	$(COMPOSE_PREPROD) up -d --build $(PREPROD_CORE_SERVICES)

preprod-build:
	$(COMPOSE_PREPROD) build $(PREPROD_BUILD_SERVICES)

preprod-build-no-cache:
	$(COMPOSE_PREPROD) build --no-cache $(PREPROD_BUILD_SERVICES)

preprod-pull:
	$(COMPOSE_PREPROD) pull $(PREPROD_CORE_SERVICES)

# Déploiement : préflight → build → up avec attente du healthcheck.
# Le contenu est un volume runtime : `make preprod-content-sync` se lance
# séparément (dépend de l'API Symfony) et est reflété sans rebuild.

preprod-deploy:
	$(MAKE) preprod-check
	$(MAKE) preprod-build
	$(MAKE) preprod-up-wait

preprod-deploy-no-cache:
	$(MAKE) preprod-check
	$(MAKE) preprod-build-no-cache
	$(MAKE) preprod-up-wait

# Lifecycle

preprod-stop:
	$(COMPOSE_PREPROD) stop

preprod-down:
	$(COMPOSE_PREPROD) down

preprod-clean:
	$(COMPOSE_PREPROD) down -v --remove-orphans

preprod-status:
	$(COMPOSE_PREPROD) ps

# Logs

preprod-logs:
	$(COMPOSE_PREPROD) logs $(FOLLOW) --tail=$(TAIL)

preprod-logs-service:
	@if [ -z "$(S)" ]; then \
		echo "Missing S=<service>. Example: make preprod-logs-service S=webapp-ssr"; \
		exit 2; \
	fi
	$(COMPOSE_PREPROD) logs $(FOLLOW) --tail=$(TAIL) $(S)

preprod-logs-webapp:
	$(COMPOSE_PREPROD) logs $(FOLLOW) --tail=$(TAIL) webapp-ssr