{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": ["@modyfi/vite-plugin-yaml/modules", "node"],
    "paths": {
      "#imports": ["./.nuxt/imports"],
      "#imports/*": ["./.nuxt/imports/*"],
      "@schemas/dtos": ["./schemas/dtos"],
      "@schemas/dtos/*": ["./schemas/dtos/*"],
      "@schemas/interfaces": ["./schemas/interfaces"],
      "@schemas/interfaces/*": ["./schemas/interfaces/*"],
      "~/*": ["./app/*"],
      "@/*": ["./app/*"],
      "@utils/*": ["./app/utils/*"],
      "@locales/*": ["./i18n/locales/*"],
      "@content/*": ["./content/*"],
      "#shared": ["./shared"],
      "#shared/*": ["./shared/*"],
      "@schemas/*": ["./schemas/*"],
      "@services/*": ["./services/*"]
    }
  }
}
