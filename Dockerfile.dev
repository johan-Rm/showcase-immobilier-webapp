FROM oven/bun:1.4.0-alpine

RUN apk add --no-cache bash git curl python3 make g++ nodejs
RUN git config --global --add safe.directory /app

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install

COPY . ./

# Nuxt runs as the host UID/GID (1000 by default), not as root.
RUN mkdir -p /app/.nuxt /app/node_modules/.cache \
    && chown -R bun:bun /app/.nuxt /app/node_modules/.cache \
    && chown bun:bun /app

ENV NODE_ENV=development
ENV CONTENT_PATH=/app/content
ENV SCHEMAS_PATH=/opt/app-schemas

EXPOSE 3000

CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
