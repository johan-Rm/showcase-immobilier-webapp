# UID/GID de l'utilisateur hôte — le container dev écrit les fichiers générés
# (schemas/dtos, schemas/interfaces) avec ces permissions. Valeurs : id -u / id -g
DOCKER_UID=1000
DOCKER_GID=1000

# Chemin vers les blueprints d'architecture (README par dossier).
# Utilisé par les scripts internes pour générer la doc ou copier la structure.
BLUEPRINTS_PATH=/path/to/blueprints/directory-structure-nuxt

# Chemin des schémas YAML utilisés au build (obligatoire).
# Docker : ce chemin doit être un chemin absolu sur l'hôte, monté tel quel dans le conteneur.
SCHEMAS_PATH=/path/to/shared/schemas

DIGITAL_ORCHESTRATION_CORE_PATH=/path/to/digital-orchestration-core

# File-watching en Docker (utile sur macOS/WSL/volumes montés).
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# Serveur SSR Nitro (prod-like).
NITRO_HOST=0.0.0.0
NITRO_PORT=3000

# Monitoring (Sentry)
ENABLE_MONITORING=false
SENTRY_DSN_PUBLIC=
SENTRY_DSN=
MONITORING_ENV=development
APP_VERSION=0.0.0
SENTRY_TRACES_SAMPLE_RATE=0

# Core Web Vitals (client)
WEB_VITALS_ENABLED=false

# SEO site config
APP_ENV=dev
SITE_URL=https://mlk-my-little-kasbah.immo
SITE_NAME=MLK - My Little Kasbah

# Contenu de test : false masque les biens marques additionalProperty dataSource=fixture.
ACCOMMODATION_FIXTURES_ENABLED=false

RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="MLK - My Little Kasbah <contact@mlk-my-little-kasbah.immo>"
CONTACT_TO_EMAIL=contact@mlk-my-little-kasbah.immo
# Plusieurs destinataires possibles, separes par une virgule.
CONTACT_BCC_EMAILS=developer@graines-digitales.online,admin@example.com
CONTACT_REPLY_TO_EMAIL=contact@mlk-my-little-kasbah.immo
CONTACT_SUBMISSIONS_PATH=.data/contact-submissions.csv

# Authentification Google dashboard.
# NUXT_SESSION_PASSWORD doit contenir au moins 32 caracteres.
NUXT_SESSION_PASSWORD=password-with-at-least-32-characters

# API Symfony — valeurs strictement serveur, jamais exposees au client.
# SYMFONY_API_URL     : URL de base de l API Symfony (ex: http://localhost:18080)
# SYMFONY_API_DOCS_URL: endpoint OpenAPI consomme par Scalar
# SCALAR_API_DOCS_ENABLED: force l interface Scalar hors serveur dev local si necessaire
# SYMFONY_PROJECT_ID  : UUID du projet MLK dans Symfony
# SYMFONY_SERVICE_EMAIL / PASSWORD : compte de service pour l auth JWT
SYMFONY_API_URL=http://localhost:18080
SYMFONY_API_DOCS_URL=http://localhost:18080/api/docs
SCALAR_API_DOCS_ENABLED=false
SYMFONY_PROJECT_ID=
SYMFONY_SERVICE_EMAIL=
SYMFONY_SERVICE_PASSWORD=

# Debug ponctuel du payload de sauvegarde dashboard vers Symfony.
# Ne pas activer en production.
DASHBOARD_SAVE_DEBUG=0

# Bootstrap pré-prod (scripts/bootstrap-data/) — passwords des membres créés à l étape 03
BOOTSTRAP_JOHAN_PASSWORD=
BOOTSTRAP_CAROLINE_PASSWORD=
