# ------------------------------------------------------------------------------
# Template d'environnement commun DEV / PREPROD / PROD
#
# Usages :
# cp .env.example .env
# cp .env.example .env.preprod
# cp .env.example .env.prod
#
# Les fichiers .env, .env.preprod et .env.prod doivent être gitignorés.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Identité Docker / instance
# ------------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=mon-webapp-dev
APP_STACK_NETWORK_NAME=mon_webapp_network_dev
EDGE_ALIAS=mon-webapp-dev

DOCKER_UID=1000
DOCKER_GID=1000

# ------------------------------------------------------------------------------
# Chemins locaux
# ------------------------------------------------------------------------------

BLUEPRINTS_PATH=/path/to/blueprints/directory-structure-nuxt
SCHEMAS_PATH=/path/to/shared/schemas
DIGITAL_ORCHESTRATION_CORE_PATH=/path/to/digital-orchestration-core

# Dossier hôte des images servies sur /images (monté dans le SSR).
# Dev : laisser le défaut ./public/images.
# Preprod/prod : pointer le mediaPath du projet géré par l'API,
#   ex. /srv/webapps/blue-bay-mogador/public/images
MEDIA_HOST_DIR=./public/images

# ------------------------------------------------------------------------------
# Watchers Docker local
# ------------------------------------------------------------------------------

CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# ------------------------------------------------------------------------------
# Serveur / ports
# ------------------------------------------------------------------------------

NITRO_HOST=0.0.0.0
NITRO_PORT=3000
WEBAPP_DEV_PORT=3000
PUBLIC_HOST=webapp.localhost
PUBLIC_PORT=8080

# ------------------------------------------------------------------------------
# Application / SEO
# ------------------------------------------------------------------------------

APP_ENV=dev
SITE_URL=http://webapp.localhost:8080
SITE_NAME=Mon Webapp

WEB_VITALS_ENABLED=false
NODE_BUILD_MEMORY_MB=4096
ACCOMMODATION_FIXTURES_ENABLED=false

# ------------------------------------------------------------------------------
# Emails / Contact
# ------------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_FROM_EMAIL="Mon Webapp <contact@example.com>"
CONTACT_TO_EMAIL=contact@example.com
CONTACT_BCC_EMAILS=
CONTACT_REPLY_TO_EMAIL=contact@example.com
CONTACT_SUBMISSIONS_PATH=.data/contact-submissions.csv

# ------------------------------------------------------------------------------
# Session / Auth
# ------------------------------------------------------------------------------

NUXT_SESSION_PASSWORD=password-with-at-least-32-characters
AUTHORIZED_CLIENT_EMAILS=

# ------------------------------------------------------------------------------
# API Symfony
# ------------------------------------------------------------------------------

SYMFONY_API_URL=http://localhost:18080
SYMFONY_API_DOCS_URL=http://localhost:18080/api/docs
SCALAR_API_DOCS_ENABLED=false
SYMFONY_PROJECT_ID=
SYMFONY_SERVICE_EMAIL=
SYMFONY_SERVICE_PASSWORD=

# ------------------------------------------------------------------------------
# Debug
# ------------------------------------------------------------------------------

DASHBOARD_SAVE_DEBUG=0
