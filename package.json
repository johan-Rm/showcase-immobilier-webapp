{
  "name": "nuxt-4-tech-lab",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check:feat001": "bash scripts/check-feature-001.sh",
    "check:app:types": "bun scripts/ci/app/verify-types-placement.ts",
    "check:app:images": "bun scripts/ci/app/verify-app-image.ts",
    "check:app:components:no-business-logic": "bun scripts/ci/app/verify-no-business-logic.ts",
    "check:app:script-setup-standard": "bun scripts/ci/app/verify-script-setup-standard.ts",
    "check:app:soc": "bun scripts/ci/app/verify-soc-components.ts",
    "check:app:code-quality": "bun scripts/ci/app/verify-code-quality.ts",
    "check:app:solid": "bun scripts/ci/app/verify-solid.ts",
    "check:app:guards": "bun scripts/ci/app/verify-no-redundant-guards.ts",
    "check:services:no-framework-imports": "bun scripts/ci/services/verify-no-framework-imports.ts",
    "lint:check": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "quality:check": "bun run lint:check && bun run format:check && bun run type-check",
    "quality:fix": "bun run format:fix && bun run lint:fix",
    "test": "vitest run",
    "test:dashboard": "vitest run server/utils/dashboard/*.vitest.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report .tmp/playwright/report",
    "type-check": "nuxt prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.107",
    "@iconify-json/simple-icons": "^1.2.82",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.7.1",
    "@nuxtjs/device": "4.0.0",
    "@nuxtjs/i18n": "^10.3.0",
    "@nuxtjs/mdc": "^0.22.0",
    "@nuxtjs/sitemap": "^8.0.15",
    "@scalar/nuxt": "^0.6.41",
    "@tiptap/core": "3.23.4",
    "@tiptap/extension-history": "3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/markdown": "^3.23.4",
    "@tiptap/pm": "3.23.4",
    "@tiptap/starter-kit": "3.23.4",
    "@tiptap/vue-3": "3.23.4",
    "@vueuse/nuxt": "^14.3.0",
    "gsap": "^3.15.0",
    "markdown-it": "^14.1.1",
    "nuxt": "^4.4.5",
    "nuxt-auth-utils": "^0.5.29",
    "nuxt-tiptap-editor": "3.3.0",
    "pinia": "^3.0.4",
    "resend": "^6.12.3",
    "tailwindcss": "^4.3.0",
    "vite-svg-loader": "^5.1.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@nuxt/hints": "^1.1.1",
    "@pinia/nuxt": "^0.11.3",
    "@playwright/test": "1.61.0",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "vitest": "^4.1.7",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.9"
  }
}
