# ============================
# Docker Compose (PROD)
# ============================

PROD_PROJECT_NAME ?= mlk-webapp-prod
PROD_SITE_URL ?= https://mlk-my-little-kasbah.immo
PROD_SITE_NAME ?= MLK - My Little Kasbah
COMPOSE_PROD_ENV = APP_ENV=prod SITE_URL=$(PROD_SITE_URL) SITE_NAME="$(PROD_SITE_NAME)"
COMPOSE_PROD = $(COMPOSE_PROD_ENV) docker compose -p $(PROD_PROJECT_NAME) -f docker-compose.prod.yml

# Logs options
TAIL ?= 200
FOLLOW ?= -f

# Service groups
PROD_CORE_SERVICES = webapp-ssr
PROD_BUILD_SERVICES = webapp-ssr

.PHONY: prod-up prod-up-build prod-down prod-clean prod-stop prod-status
.PHONY: prod-build prod-build-no-cache prod-pull prod-deploy
.PHONY: prod-logs prod-logs-service prod-logs-webapp

# ----------------------------
# Up / Build / Deploy
# ----------------------------

prod-up:
	$(COMPOSE_PROD) up -d $(PROD_CORE_SERVICES)

prod-up-build:
	$(COMPOSE_PROD) up -d --build $(PROD_CORE_SERVICES)

prod-build:
	$(COMPOSE_PROD) build $(PROD_BUILD_SERVICES)

prod-build-no-cache:
	$(COMPOSE_PROD) build --no-cache $(PROD_BUILD_SERVICES)

prod-pull:
	$(COMPOSE_PROD) pull $(PROD_CORE_SERVICES)

prod-deploy:
	$(MAKE) prod-build
	$(MAKE) prod-up

# ----------------------------
# Lifecycle
# ----------------------------

prod-stop:
	$(COMPOSE_PROD) stop

prod-down:
	$(COMPOSE_PROD) down

prod-clean:
	$(COMPOSE_PROD) down -v --remove-orphans

prod-status:
	$(COMPOSE_PROD) ps

# ----------------------------
# Logs
# ----------------------------

prod-logs:
	$(COMPOSE_PROD) logs $(FOLLOW) --tail=$(TAIL)

prod-logs-service:
	@if [ -z "$(S)" ]; then \
		echo "Missing S=<service>. Example: make prod-logs-service S=webapp-ssr"; \
		exit 2; \
	fi
	$(COMPOSE_PROD) logs $(FOLLOW) --tail=$(TAIL) $(S)

prod-logs-webapp:
	$(COMPOSE_PROD) logs $(FOLLOW) --tail=$(TAIL) webapp-ssr
