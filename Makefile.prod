# ============================
# Docker Compose PROD
# ============================

PROD_ENV_FILE ?= .env.prod
COMPOSE_PROD = docker compose --env-file $(PROD_ENV_FILE) -f docker-compose.prod.yml

PROD_CORE_SERVICES = webapp-ssr
PROD_BUILD_SERVICES = webapp-ssr

.PHONY: prod-up prod-up-build prod-down prod-clean prod-stop prod-status
.PHONY: prod-build prod-build-no-cache prod-pull prod-deploy prod-deploy-no-cache
.PHONY: prod-content-sync prod-content-sync-dry
.PHONY: prod-logs prod-logs-service prod-logs-webapp

# Content Sync

prod-content-sync:
	$(COMPOSE_PROD) run --rm content-sync

prod-content-sync-dry:
	$(COMPOSE_PROD) run --rm content-sync bun scripts/content-sync.ts --dry-run

# Up / Build / Deploy

prod-up:
	$(COMPOSE_PROD) up -d $(PROD_CORE_SERVICES)

prod-up-build:
	$(COMPOSE_PROD) up -d --build $(PROD_CORE_SERVICES)

prod-build:
	$(COMPOSE_PROD) build $(PROD_BUILD_SERVICES)

prod-build-no-cache:
	$(COMPOSE_PROD) build --no-cache $(PROD_BUILD_SERVICES)

prod-pull:
	$(COMPOSE_PROD) pull $(PROD_CORE_SERVICES)

prod-deploy:
	$(MAKE) prod-build
	$(MAKE) prod-up

prod-deploy-no-cache:
	$(MAKE) prod-build-no-cache
	$(MAKE) prod-up

# Lifecycle

prod-stop:
	$(COMPOSE_PROD) stop

prod-down:
	$(COMPOSE_PROD) down

prod-clean:
	$(COMPOSE_PROD) down -v --remove-orphans

prod-status:
	$(COMPOSE_PROD) ps

# Logs

prod-logs:
	$(COMPOSE_PROD) logs $(FOLLOW) --tail=$(TAIL)

prod-logs-service:
	@if [ -z "$(S)" ]; then \
		echo "Missing S=<service>. Example: make prod-logs-service S=webapp-ssr"; \
		exit 2; \
	fi
	$(COMPOSE_PROD) logs $(FOLLOW) --tail=$(TAIL) $(S)

prod-logs-webapp:
	$(COMPOSE_PROD) logs $(FOLLOW) --tail=$(TAIL) webapp-ssr